{
  "description": "Shared cases for the JSON Schemas and the Swift validator. Each case changes a base document (set: dotted path to value, remove: dotted paths), then states whether the JSON Schema accepts the result and the exact issues the validator reports (code and JSON Pointer; with against_preset, also the rules that need kinetic-minimal). A case the schema accepts but the validator rejects is a validator-only rule.",
  "bases": {
    "preset": "captions/presets/kinetic-minimal.json",
    "input": "captions/examples/two-cues.input.json"
  },
  "cases": [
    { "name": "preset as shipped", "document": "preset", "schema": true, "validator": [] },
    { "name": "preset without description", "document": "preset", "remove": ["description"], "schema": true, "validator": [] },
    { "name": "hex colour", "document": "preset", "set": { "text.color": "#ece7e0" }, "schema": true, "validator": [] },
    { "name": "landscape canvas at 30 fps", "document": "preset", "set": { "canvas": { "width": 1920, "height": 1080, "fps": 30 }, "placement.x": 960 }, "schema": true, "validator": [] },
    { "name": "unknown field", "document": "preset", "set": { "colour": "#ffffff" }, "schema": false, "validator": ["field.unknown /colour"] },
    { "name": "unknown nested field", "document": "preset", "set": { "text.weight": 500 }, "schema": false, "validator": ["field.unknown /text/weight"] },
    { "name": "missing required field", "document": "preset", "remove": ["shadow.blur"], "schema": false, "validator": ["field.missing /shadow/blur"] },
    { "name": "number as string", "document": "preset", "set": { "text.size": "54" }, "schema": false, "validator": ["type.mismatch /text/size"] },
    { "name": "fractional integer", "document": "preset", "set": { "canvas.width": 1080.5 }, "schema": false, "validator": ["type.mismatch /canvas/width"] },
    { "name": "above maximum", "document": "preset", "set": { "outline.alpha": 1.2 }, "schema": false, "validator": ["value.out_of_range /outline/alpha"] },
    { "name": "frame rate above maximum", "document": "preset", "set": { "canvas.fps": 241 }, "schema": false, "validator": ["value.out_of_range /canvas/fps"] },
    { "name": "size not above zero", "document": "preset", "set": { "text.size": 0 }, "schema": false, "validator": ["value.out_of_range /text/size"] },
    { "name": "negative duration", "document": "preset", "set": { "animation.fade_in.duration": -0.14 }, "schema": false, "validator": ["value.out_of_range /animation/fade_in/duration"] },
    { "name": "no lines allowed", "document": "preset", "set": { "text.max_lines": 0 }, "schema": false, "validator": ["value.out_of_range /text/max_lines"] },
    { "name": "negative colour component", "document": "preset", "set": { "text.color.srgb.1": -0.1 }, "schema": false, "validator": ["value.out_of_range /text/color/srgb/1"] },
    { "name": "unknown easing", "document": "preset", "set": { "animation.fade_out.easing": "bounce" }, "schema": false, "validator": ["value.invalid /animation/fade_out/easing"] },
    { "name": "unknown switch point", "document": "preset", "set": { "emphasis_styles.soft.font_from": "word-start" }, "schema": false, "validator": ["value.invalid /emphasis_styles/soft/font_from"] },
    { "name": "reserved placement mode", "document": "preset", "set": { "placement.mode": "auto" }, "schema": false, "validator": ["option.unsupported /placement/mode"] },
    { "name": "reserved alignment", "document": "preset", "set": { "text.align": "left" }, "schema": false, "validator": ["option.unsupported /text/align"] },
    { "name": "short hex colour", "document": "preset", "set": { "text.color": "#ece7e" }, "schema": false, "validator": ["value.invalid /text/color"] },
    { "name": "two colour components", "document": "preset", "set": { "text.color.srgb": [1, 1] }, "schema": false, "validator": ["value.invalid /text/color/srgb"] },
    { "name": "preset id with spaces", "document": "preset", "set": { "preset_id": "Kinetic Minimal" }, "schema": false, "validator": ["value.invalid /preset_id"] },
    { "name": "two-part version", "document": "preset", "set": { "preset_version": "1.0" }, "schema": false, "validator": ["value.invalid /preset_version"] },
    { "name": "empty font name", "document": "preset", "set": { "text.font": "" }, "schema": false, "validator": ["value.invalid /text/font"] },
    { "name": "style name in capitals", "document": "preset", "set": { "emphasis_styles.Soft": { "font": "Palatino-Italic", "size": 58, "color": "#c3b3e0", "transition": { "duration": 0.22, "lead": 0.02, "easing": "smoothstep", "threshold": 0.02 }, "font_from": "cue-start", "size_from": "threshold" } }, "schema": false, "validator": ["value.invalid /emphasis_styles/Soft"] },
    { "name": "no fonts", "document": "preset", "set": { "required_fonts": [] }, "schema": false, "validator": ["array.empty /required_fonts"] },
    { "name": "font listed twice", "document": "preset", "set": { "required_fonts": ["AvenirNext-Medium", "Palatino-Italic", "Palatino-Italic"] }, "schema": false, "validator": ["id.duplicate /required_fonts/2"] },
    { "name": "newer preset schema", "document": "preset", "set": { "schema_version": 2 }, "schema": false, "validator": ["schema.unsupported_version /schema_version"] },
    { "name": "font used but not declared", "document": "preset", "set": { "emphasis_styles.soft.font": "Georgia-Italic" }, "schema": true, "validator": ["font.undeclared /required_fonts", "font.unused /required_fonts/1"] },
    { "name": "placement outside the canvas", "document": "preset", "set": { "placement.x": 2000 }, "schema": true, "validator": ["value.out_of_range /placement/x"] },

    { "name": "input as shipped", "document": "input", "against_preset": true, "schema": true, "validator": [] },
    { "name": "word left out", "document": "input", "set": { "cues.1.lines": [["w7", "w8", "w9", "w10"]] }, "schema": true, "validator": ["word.unused /words/10"] },
    { "name": "overlapping cue windows", "document": "input", "set": { "cues.0.end": 4.0 }, "against_preset": true, "schema": true, "validator": [] },
    { "name": "unknown top-level field", "document": "input", "set": { "speaker": "narrator" }, "schema": false, "validator": ["field.unknown /speaker"] },
    { "name": "unknown word field", "document": "input", "set": { "words.0.confidence": 0.9 }, "schema": false, "validator": ["field.unknown /words/0/confidence"] },
    { "name": "missing language", "document": "input", "remove": ["language"], "schema": false, "validator": ["field.missing /language"] },
    { "name": "timestamp as string", "document": "input", "set": { "words.0.start": "0.5" }, "schema": false, "validator": ["type.mismatch /words/0/start"] },
    { "name": "negative timestamp", "document": "input", "set": { "words.0.start": -0.1 }, "schema": false, "validator": ["value.out_of_range /words/0/start"] },
    { "name": "no words", "document": "input", "set": { "words": [] }, "schema": false, "validator": ["array.empty /words"] },
    { "name": "empty line", "document": "input", "set": { "cues.1.lines": [["w7"], []] }, "schema": false, "validator": ["array.empty /cues/1/lines/1"] },
    { "name": "unknown timing source", "document": "input", "set": { "timing_source": "guessed" }, "schema": false, "validator": ["value.invalid /timing_source"] },
    { "name": "invalid language tag", "document": "input", "set": { "language": "english!" }, "schema": false, "validator": ["value.invalid /language"] },
    { "name": "empty word text", "document": "input", "set": { "words.0.text": "" }, "schema": false, "validator": ["value.invalid /words/0/text"] },
    { "name": "emphasis style as number", "document": "input", "set": { "cues.0.emphasis.w6": 1 }, "schema": false, "validator": ["type.mismatch /cues/0/emphasis/w6"] },
    { "name": "newer input schema", "document": "input", "set": { "schema_version": 2 }, "schema": false, "validator": ["schema.unsupported_version /schema_version"] },
    { "name": "end not after start", "document": "input", "set": { "words.0.end": 0.5 }, "schema": true, "validator": ["timing.invalid /words/0/end"] },
    { "name": "cue end before cue start", "document": "input", "set": { "cues.1.end": 2.0 }, "schema": true, "validator": ["timing.invalid /cues/1/end"] },
    { "name": "words out of order", "document": "input", "set": { "words.1.start": 0.4, "words.1.end": 0.45 }, "schema": true, "validator": ["timing.out_of_order /words/1/start"] },
    { "name": "repeated word id", "document": "input", "set": { "words.1.id": "w1" }, "schema": true, "validator": ["id.duplicate /words/1/id"] },
    { "name": "unknown word in a cue", "document": "input", "set": { "cues.1.lines": [["w7", "w8", "w9", "w10", "x"]] }, "schema": true, "validator": ["word.unknown /cues/1/lines/0/4"] },
    { "name": "word in two cues", "document": "input", "set": { "cues.1.lines": [["w6", "w7", "w8", "w9", "w10", "w11"]] }, "schema": true, "validator": ["word.reused /cues/1/lines/0/0"] },
    { "name": "interleaved cues", "document": "input", "set": { "cues.0.lines": [["w1", "w2"], ["w3", "w4", "w5", "w7"]], "cues.0.emphasis": {}, "cues.1.lines": [["w6", "w8", "w9", "w10", "w11"]] }, "schema": true, "validator": ["timing.out_of_order /cues/1"] },
    { "name": "emphasis outside its cue", "document": "input", "set": { "cues.1.emphasis": { "w1": "soft" } }, "schema": true, "validator": ["emphasis.word_not_in_cue /cues/1/emphasis/w1"] },
    { "name": "text not in NFC", "document": "input", "set": { "words.0.text": "Café" }, "schema": true, "validator": ["text.not_normalized /words/0/text"] },
    { "name": "whitespace in a word", "document": "input", "set": { "words.0.text": "two words" }, "schema": true, "validator": ["text.contains_whitespace /words/0/text"] },
    { "name": "control character in a word", "document": "input", "set": { "words.0.text": "Small\u0007" }, "schema": true, "validator": ["text.contains_control /words/0/text"] },
    { "name": "more lines than the preset allows", "document": "input", "set": { "cues.1.lines": [["w7"], ["w8"], ["w9", "w10", "w11"]] }, "against_preset": true, "schema": true, "validator": ["cue.too_many_lines /cues/1/lines"] },
    { "name": "style the preset does not define", "document": "input", "set": { "cues.0.emphasis.w6": "shake" }, "against_preset": true, "schema": true, "validator": ["emphasis.unknown_style /cues/0/emphasis/w6"] },
    { "name": "empty cue window", "document": "input", "set": { "cues.1.start": 9.0 }, "remove": ["cues.1.end"], "against_preset": true, "schema": true, "validator": ["timing.invalid /cues/1"] }
  ]
}
